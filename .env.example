# All variables are optional; the defaults below are what the app uses without a .env file.

# Base URL of the ranking/history API. Empty = same origin (served by the MSW mocks).
VITE_API_BASE_URL=

# Client timeout for API calls, in milliseconds.
VITE_API_TIMEOUT_MS=5000

# Set to "false" to disable the MSW mock API (e.g. against a real backend).
VITE_ENABLE_MOCKS=true
